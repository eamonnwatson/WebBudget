@inherits LayoutComponentBase
@using PredictiveBudget.Web.Styling

<MudThemeProvider Theme="@AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h5" Class="app-title">Predictive Budget</MudText>
        <MudSpacer />
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
            Local on your Raspberry Pi
        </MudChip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="1" Class="app-drawer">
        <MudStack Spacing="3" Class="drawer-stack">
            <div>
                <MudText Typo="Typo.overline" Class="section-label">Workspace</MudText>
                <MudText Typo="Typo.h6">Budget planning cockpit</MudText>
                <MudText Typo="Typo.body2" Class="drawer-copy">
                    Track recurring cash flow, plan one-off spending, and inspect the forecast from any device on your LAN.
                </MudText>
            </div>

            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">
                    Dashboard
                </MudNavLink>
            </MudNavMenu>
        </MudStack>
    </MudDrawer>

    <MudMainContent Class="main-shell">
        <MudContainer MaxWidth="MaxWidth.False" Class="content-shell">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
        => _drawerOpen = !_drawerOpen;
}
