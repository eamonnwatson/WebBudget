@page "/plans/{PlanId:guid}"
@rendermode InteractiveServer

<PageTitle>@(_plan?.Name ?? "Budget plan")</PageTitle>

@if (_isLoading)
{
    <div class="loading-state">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_plan is null)
{
    <MudPaper Class="pa-6">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This budget plan could not be found.
        </MudAlert>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
            Back to dashboard
        </MudButton>
    </MudPaper>
}
else
{
    <MudStack Spacing="4">
        <MudPaper Class="workspace-card pa-4">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="header-actions">
                    <MudButton Href="/" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack">
                        All plans
                    </MudButton>
                    <MudSpacer />
                    <MudChip T="string" Value="@_plan.Currency" Variant="Variant.Outlined" Color="Color.Primary">
                        @_plan.Currency
                    </MudChip>
                    <MudChip T="string" Value="@_plan.TimeZoneId" Variant="Variant.Outlined" Color="Color.Secondary">
                        @_plan.TimeZoneId
                    </MudChip>
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Class="workspace-summary">
                    <div>
                        <MudText Typo="Typo.overline" Class="section-kicker">Plan workspace</MudText>
                        <MudText Typo="Typo.h4">@_plan.Name</MudText>
                        <MudText Typo="Typo.body2" Class="section-copy">
                            Balance checkpoint @FormatMoney(_plan.StartingBalance) as of @FormatDate(_plan.BalanceAsOfDate).
                        </MudText>
                    </div>
                    <MudSpacer />
                    <MudStack Row="true" Class="stat-strip">
                        <MudChip T="string" Value="@($"{_plan.RecurringRules.Count} rules")" Variant="Variant.Outlined" Color="Color.Primary">
                            @_plan.RecurringRules.Count rules
                        </MudChip>
                        <MudChip T="string" Value="@($"{_plan.PlannedTransactions.Count} planned")" Variant="Variant.Outlined" Color="Color.Primary">
                            @_plan.PlannedTransactions.Count planned
                        </MudChip>
                        <MudChip T="string" Value="@($"{_plan.Overrides.Count} overrides")" Variant="Variant.Outlined" Color="Color.Primary">
                            @_plan.Overrides.Count overrides
                        </MudChip>
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudGrid>
            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-5 panel-card">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="table-toolbar">
                            <div>
                                <MudText Typo="Typo.h6">Recurring rules</MudText>
                                <MudText Typo="Typo.body2" Class="section-copy">
                                    Repeating income and expense patterns for this plan.
                                </MudText>
                            </div>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddRecurringRuleModal">
                                Add rule
                            </MudButton>
                        </MudStack>

                        @if (_plan.RecurringRules.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                No recurring rules yet.
                            </MudAlert>
                        }
                        else
                        {
                            <MudTable Items="_plan.RecurringRules.OrderBy(rule => rule.Name)" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Name</MudTh>
                                    <MudTh>Pattern</MudTh>
                                    <MudTh>Amount</MudTh>
                                    <MudTh>Window</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Name">@context.Name</MudTd>
                                    <MudTd DataLabel="Pattern">@DescribeRecurrence(context.Recurrence)</MudTd>
                                    <MudTd DataLabel="Amount">@FormatSignedMoney(context.Direction, context.Amount)</MudTd>
                                    <MudTd DataLabel="Window">@DescribeEffectiveWindow(context)</MudTd>
                                    <MudTd Class="actions-cell">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditRecurringRuleModal(context.RuleId))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OpenDeleteRecurringRuleConfirmation(context.RuleId, context.Name))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-5 panel-card">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="table-toolbar">
                            <div>
                                <MudText Typo="Typo.h6">Planned transactions</MudText>
                                <MudText Typo="Typo.body2" Class="section-copy">
                                    One-off transactions that should affect the forecast.
                                </MudText>
                            </div>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddPlannedTransactionModal">
                                Add transaction
                            </MudButton>
                        </MudStack>

                        @if (_plan.PlannedTransactions.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                No planned transactions yet.
                            </MudAlert>
                        }
                        else
                        {
                            <MudTable Items="_plan.PlannedTransactions.OrderBy(transaction => transaction.Date).ThenBy(transaction => transaction.Name)" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Name</MudTh>
                                    <MudTh>Direction</MudTh>
                                    <MudTh>Amount</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Date">@FormatDate(context.Date)</MudTd>
                                    <MudTd DataLabel="Name">@context.Name</MudTd>
                                    <MudTd DataLabel="Direction">@context.Direction</MudTd>
                                    <MudTd DataLabel="Amount">@FormatSignedMoney(context.Direction, context.Amount)</MudTd>
                                    <MudTd Class="actions-cell">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditPlannedTransactionModal(context.TransactionId))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OpenDeletePlannedTransactionConfirmation(context.TransactionId, context.Name))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-5 panel-card">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="table-toolbar">
                    <div>
                        <MudText Typo="Typo.h6">Occurrence overrides</MudText>
                        <MudText Typo="Typo.body2" Class="section-copy">
                            Override or skip generated occurrences without leaving the workspace.
                        </MudText>
                    </div>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(!CanEditOverrides)"
                               OnClick="OpenAddOverrideModal">
                        Add override
                    </MudButton>
                </MudStack>

                @if (_plan.Overrides.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        No occurrence overrides yet.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="_plan.Overrides.OrderBy(overrideEntry => overrideEntry.OriginalDate)" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Source</MudTh>
                            <MudTh>Original date</MudTh>
                            <MudTh>Action</MudTh>
                            <MudTh>Effect</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Source">@GetOverrideSourceLabel(context)</MudTd>
                            <MudTd DataLabel="Original date">@FormatDate(context.OriginalDate)</MudTd>
                            <MudTd DataLabel="Action">@context.Action</MudTd>
                            <MudTd DataLabel="Effect">@DescribeOverride(context)</MudTd>
                            <MudTd Class="actions-cell">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditOverrideModal(context.OverrideId))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OpenDeleteOverrideConfirmation(context.OverrideId, GetOverrideSourceLabel(context)))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>

    </MudStack>
}

@if (_showRecurringRuleModal)
{
    <div class="modal-backdrop">
        <MudPaper Class="modal-card compact-rule-modal pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5">@RecurringRuleModalTitle</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseAllModals" />
                </MudStack>

                <EditForm Model="_recurringRuleForm" OnValidSubmit="SaveRecurringRuleAsync">
                    <DataAnnotationsValidator />
                    <MudGrid Spacing="2" Class="compact-form-grid">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Rule name" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.Name" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="TransactionDirection" Label="Direction" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.Direction">
                                <MudSelectItem Value="TransactionDirection.Inflow">Inflow</MudSelectItem>
                                <MudSelectItem Value="TransactionDirection.Outflow">Outflow</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal?" Label="Amount" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.Amount" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="RecurrencePattern" Label="Pattern" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.Pattern">
                                <MudSelectItem Value="RecurrencePattern.Weekly">Weekly</MudSelectItem>
                                <MudSelectItem Value="RecurrencePattern.MonthlyByDayOfMonth">Monthly</MudSelectItem>
                                <MudSelectItem Value="RecurrencePattern.YearlyByMonthsAndDay">Yearly</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker Label="Effective start" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="_recurringRuleForm.EffectiveStartDate" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker Label="Effective end" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="_recurringRuleForm.EffectiveEndDate" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="BusinessDayAdjustment" Label="Business day adjustment" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.BusinessDayAdjustment">
                                <MudSelectItem Value="BusinessDayAdjustment.None">None</MudSelectItem>
                                <MudSelectItem Value="BusinessDayAdjustment.NextBusinessDay">Next business day</MudSelectItem>
                                <MudSelectItem Value="BusinessDayAdjustment.PreviousBusinessDay">Previous business day</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="int?" Label="Alert days before" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.DefaultAlertDaysBefore" />
                        </MudItem>
                        <MudItem xs="12" md="6" Class="compact-toggle-item">
                            <MudCheckBox T="bool" Label="Rule is active" @bind-Value="_recurringRuleForm.IsActive" />
                        </MudItem>
                    </MudGrid>

                    @if (_recurringRuleForm.Pattern == RecurrencePattern.Weekly)
                    {
                        <MudPaper Class="recurrence-panel compact-recurrence-panel pa-3 mt-3" Outlined="true">
                            <MudText Typo="Typo.subtitle2">Weekly settings</MudText>
                            <MudNumericField T="int?" Label="Repeat every n weeks" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" @bind-Value="_recurringRuleForm.IntervalWeeks" />
                            <MudGrid Spacing="1" Class="mt-1">
                                @foreach (var weekday in WeekdayOptions)
                                {
                                    <MudItem xs="6" sm="4">
                                        <MudCheckBox T="bool"
                                                     Label="@weekday.ToString()"
                                                     Value="@IsWeekdaySelected(weekday)"
                                                     ValueChanged="@((bool value) => SetWeekday(weekday, value))" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>
                    }
                    else if (_recurringRuleForm.Pattern == RecurrencePattern.MonthlyByDayOfMonth)
                    {
                        <MudPaper Class="recurrence-panel compact-recurrence-panel pa-3 mt-3" Outlined="true">
                            <MudText Typo="Typo.subtitle2">Monthly settings</MudText>
                            <MudGrid Spacing="2" Class="mt-1">
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int?" Label="Repeat every n months" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.IntervalMonths" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int?" Label="Day of month" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_recurringRuleForm.DayOfMonth" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    else
                    {
                        <MudPaper Class="recurrence-panel compact-recurrence-panel pa-3 mt-3" Outlined="true">
                            <MudText Typo="Typo.subtitle2">Yearly settings</MudText>
                            <MudNumericField T="int?" Label="Day of month" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" @bind-Value="_recurringRuleForm.DayOfMonth" />
                            <MudGrid Spacing="1" Class="mt-1">
                                @foreach (var month in MonthOptions)
                                {
                                    <MudItem xs="6" sm="4">
                                        <MudCheckBox T="bool"
                                                     Label="@month.Label"
                                                     Value="@IsMonthSelected(month.Number)"
                                                     ValueChanged="@((bool value) => SetMonth(month.Number, value))" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>
                    }

                    <MudStack Row="true" Class="modal-actions mt-3">
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                            Save rule
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    </div>
}

@if (_showPlannedTransactionModal)
{
    <div class="modal-backdrop">
        <MudPaper Class="modal-card pa-6">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5">@PlannedTransactionModalTitle</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseAllModals" />
                </MudStack>

                <EditForm Model="_plannedTransactionForm" OnValidSubmit="SavePlannedTransactionAsync">
                    <DataAnnotationsValidator />
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Transaction date" Variant="Variant.Outlined" @bind-Date="_plannedTransactionForm.Date" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="TransactionDirection" Label="Direction" Variant="Variant.Outlined" @bind-Value="_plannedTransactionForm.Direction">
                                <MudSelectItem Value="TransactionDirection.Inflow">Inflow</MudSelectItem>
                                <MudSelectItem Value="TransactionDirection.Outflow">Outflow</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Description" Variant="Variant.Outlined" @bind-Value="_plannedTransactionForm.Name" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField T="decimal?" Label="Amount" Variant="Variant.Outlined" @bind-Value="_plannedTransactionForm.Amount" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Class="modal-actions mt-4">
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                            Save transaction
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    </div>
}

@if (_showOverrideModal)
{
    <div class="modal-backdrop">
        <MudPaper Class="modal-card pa-6">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5">@OverrideModalTitle</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseAllModals" />
                </MudStack>

                <EditForm Model="_overrideForm" OnValidSubmit="SaveOverrideAsync">
                    <DataAnnotationsValidator />
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="OccurrenceSource"
                                       Label="Source type"
                                       Variant="Variant.Outlined"
                                       Value="_overrideForm.Source"
                                       ValueChanged="OnOverrideSourceChanged">
                                <MudSelectItem Value="OccurrenceSource.RecurringRule">Recurring rule</MudSelectItem>
                                <MudSelectItem Value="OccurrenceSource.PlannedTransaction">Planned transaction</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Label="Source item" Variant="Variant.Outlined" @bind-Value="_overrideForm.SourceId">
                                @foreach (var option in GetSourceOptions(_overrideForm.Source))
                                {
                                    <MudSelectItem Value="@option.Id">@option.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Original occurrence date" Variant="Variant.Outlined" @bind-Date="_overrideForm.OriginalDate" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="OverrideAction" Label="Action" Variant="Variant.Outlined" @bind-Value="_overrideForm.Action">
                                <MudSelectItem Value="OverrideAction.Skip">Skip</MudSelectItem>
                                <MudSelectItem Value="OverrideAction.MoveToDate">Move to date</MudSelectItem>
                                <MudSelectItem Value="OverrideAction.ReplaceAmount">Replace amount</MudSelectItem>
                                <MudSelectItem Value="OverrideAction.ReplaceName">Replace name</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        @if (_overrideForm.Action == OverrideAction.MoveToDate)
                        {
                            <MudItem xs="12">
                                <MudDatePicker Label="New date" Variant="Variant.Outlined" @bind-Date="_overrideForm.NewDate" />
                            </MudItem>
                        }
                        else if (_overrideForm.Action == OverrideAction.ReplaceAmount)
                        {
                            <MudItem xs="12">
                                <MudNumericField T="decimal?" Label="New amount" Variant="Variant.Outlined" @bind-Value="_overrideForm.NewAmount" />
                            </MudItem>
                        }
                        else if (_overrideForm.Action == OverrideAction.ReplaceName)
                        {
                            <MudItem xs="12">
                                <MudTextField T="string" Label="New name" Variant="Variant.Outlined" @bind-Value="_overrideForm.NewName" />
                            </MudItem>
                        }
                    </MudGrid>

                    <MudStack Row="true" Class="modal-actions mt-4">
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_overrideForm.SourceId)">
                            Save override
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    </div>
}

@if (_showDeleteModal)
{
    <div class="modal-backdrop">
        <MudPaper Class="modal-card pa-6">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h5">@_deleteModalTitle</MudText>
                <MudText Typo="Typo.body2" Class="section-copy">@_deleteModalMessage</MudText>
                <MudStack Row="true" Class="modal-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="ConfirmDeleteAsync">
                        Delete
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </div>
}
