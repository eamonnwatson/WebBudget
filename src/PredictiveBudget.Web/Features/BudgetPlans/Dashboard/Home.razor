@page "/"
@rendermode InteractiveServer

@* Serves as the landing dashboard for plan selection, forecasting, and quick balance updates. *@
<PageTitle>@(_selectedPlan?.Name ?? "Budget dashboard")</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="page-header">
        <div>
            <MudText Typo="Typo.h4">Budget dashboard</MudText>
            <MudText Typo="Typo.body2" Class="section-copy">
                Review the active forecast, scan upcoming transactions, and jump into the full plan workspace when you need to manage the details.
            </MudText>
        </div>
        <MudSpacer />
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="page-toolbar">
            @if (_selectedPlan is not null)
            {
                <MudSelect T="Guid"
                           Label="Plan"
                           Dense="true"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Class="plan-switcher"
                           Value="_selectedPlan.PlanId"
                           ValueChanged="ChangeSelectedPlanAsync">
                    @foreach (var plan in _plans)
                    {
                        <MudSelectItem Value="@plan.PlanId">@plan.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudButton Href="@($"/plans/{_selectedPlan.PlanId}")"
                           Variant="Variant.Text"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.OpenInNew">
                    Full workspace
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@(() => LoadPlansAsync(_selectedPlan.PlanId, false))">
                    Refresh
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="OpenDeletePlanModal">
                    Delete
                </MudButton>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="OpenCreatePlanModal">
                New plan
            </MudButton>
        </MudStack>
    </MudStack>

    @if (_isLoading)
    {
        <MudPaper Class="panel-card pa-6">
            <div class="loading-state">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        </MudPaper>
    }
    else if (_selectedPlan is null)
    {
        <MudPaper Class="panel-card pa-6">
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.h4">Create your first budget plan</MudText>
                    <MudText Typo="Typo.body2" Class="section-copy">
                        There are no plans yet, so start by creating one with a reconciled balance and time zone.
                    </MudText>
                </div>
                <MudStack Row="true" Class="action-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="OpenCreatePlanModal">
                        Create plan
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-5 panel-card">
            <MudStack Spacing="4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="forecast-header">
                    <div>
                        <MudText Typo="Typo.h5">Forecast summary</MudText>
                        <MudText Typo="Typo.body2" Class="section-copy">
                            The summary, chart, and transaction list all reflect the selected forecast window.
                        </MudText>
                    </div>
                    <MudSpacer />
                    <EditForm Model="_forecastForm" OnValidSubmit="RunForecastAsync">
                        <DataAnnotationsValidator />
                        <MudStack Row="true" Class="forecast-form">
                            <MudDatePicker Label="Start" Variant="Variant.Outlined" @bind-Date="_forecastForm.StartDate" />
                            <MudDatePicker Label="End" Variant="Variant.Outlined" @bind-Date="_forecastForm.EndDate" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShowChart">
                                Refresh forecast
                            </MudButton>
                        </MudStack>
                    </EditForm>
                </MudStack>

                @if (_forecastResult is null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Run a forecast to see the minimum, maximum, below-zero risk, and balance trend for this plan.
                    </MudAlert>
                }
                else
                {
                    <MudGrid>
                        <MudItem xs="12" md="6" lg="3">
                            <MudPaper Class="summary-card pa-4" Outlined="true">
                                <MudText Typo="Typo.overline">Today's balance</MudText>
                                @if (TodayBalancePoint is null)
                                {
                                    <MudText Typo="Typo.h5">Outside window</MudText>
                                    <MudText Typo="Typo.body2">Include @DateTime.Today.ToString("MMM d, yyyy") in the selected range</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.h5">@FormatMoney(TodayBalancePoint.EndOfDayBalance)</MudText>
                                    <MudText Typo="Typo.body2">@FormatDate(TodayBalancePoint.Date)</MudText>
                                }
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6" lg="3">
                            <MudPaper Class="summary-card pa-4" Outlined="true">
                                <MudText Typo="Typo.overline">Maximum balance</MudText>
                                <MudText Typo="Typo.h5">@FormatMoney(_forecastResult.Summary.MaxBalance)</MudText>
                                <MudText Typo="Typo.body2">@FormatDate(_forecastResult.Summary.MaxDate)</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6" lg="3">
                            <MudPaper Class="summary-card pa-4" Outlined="true">
                                <MudText Typo="Typo.overline">Minimum balance</MudText>
                                <MudText Typo="Typo.h5">@FormatMoney(_forecastResult.Summary.MinBalance)</MudText>
                                <MudText Typo="Typo.body2">@FormatDate(_forecastResult.Summary.MinDate)</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6" lg="3">
                            <MudPaper Class="summary-card pa-4" Outlined="true">
                                <MudText Typo="Typo.overline">First below zero</MudText>
                                <MudText Typo="Typo.h5">@(_forecastResult.Summary.FirstBelowZeroDate is null ? "Stays above zero" : FormatDate(_forecastResult.Summary.FirstBelowZeroDate.Value))</MudText>
                                <MudText Typo="Typo.body2">@_forecastResult.BelowZeroDates.Count day(s) below zero in this window</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <MudPaper Class="summary-card chart-card pa-4" Outlined="true">
                        <MudStack Spacing="2">
                            <div class="section-header">
                                <div>
                                    <MudText Typo="Typo.subtitle1">Balance trend</MudText>
                                    <MudText Typo="Typo.body2" Class="section-copy">
                                        Daily end-of-day balances across the selected forecast window.
                                    </MudText>
                                </div>
                            </div>
                            <div class="chart-shell">
                                <MudChart T="double"
                                          ChartType="ChartType.Line"
                                          ChartSeries="@_forecastChartSeries"
                                          ChartLabels="@_forecastChartLabels"
                                          ChartOptions="@_forecastChartOptions"
                                          Width="90%"
                                          Height="360px"
                                          Class="forecast-chart"
                                          MatchBoundsToSize="true" />
                            </div>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Class="summary-card pa-4" Outlined="true">
                        <MudStack Spacing="3">
                            <div class="section-header">
                                <div>
                                    <MudText Typo="Typo.subtitle1">Transaction summary</MudText>
                                    <MudText Typo="Typo.body2" Class="section-copy">
                                        Upcoming forecasted transactions inside this window.
                                    </MudText>
                                </div>
                            </div>

                            @if (UpcomingForecastOccurrences.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    No forecasted transactions fall inside this date range.
                                </MudAlert>
                            }
                            else
                            {
                                <MudTable Items="UpcomingForecastRows" Dense="true" Hover="true" RowsPerPage="25">
                                    <HeaderContent>
                                        <MudTh>Date</MudTh>
                                        <MudTh>Name</MudTh>
                                        <MudTh>Source</MudTh>
                                        <MudTh Style="text-align:right;">Amount</MudTh>
                                        <MudTh Style="text-align:right;">Balance</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Date">@FormatDate(context.Occurrence.Date)</MudTd>
                                        <MudTd DataLabel="Name">@context.Occurrence.Name</MudTd>
                                        <MudTd DataLabel="Source">@GetOccurrenceSourceLabel(context.Occurrence)</MudTd>
                                        <MudTd DataLabel="Amount"
                                               Class="@GetAmountClass(context.Occurrence.Direction)"
                                               Style="text-align:right;">
                                            @FormatSignedMoney(context.Occurrence.Direction, context.Occurrence.Amount)
                                        </MudTd>
                                        <MudTd DataLabel="Balance"
                                               Class="transaction-running-balance"
                                               Style="text-align:right;">
                                            @FormatMoney(context.RunningBalance)
                                        </MudTd>
                                    </RowTemplate>
                                    <PagerContent>
                                        <MudTablePager PageSizeOptions="new int[] { 25, 50 }" />
                                    </PagerContent>
                                </MudTable>
                            }
                        </MudStack>
                    </MudPaper>

                    <MudPaper Class="summary-card pa-4" Outlined="true">
                        <MudStack Spacing="3">
                            <div>
                                <MudText Typo="Typo.subtitle1">Update balance</MudText>
                                <MudText Typo="Typo.body2" Class="section-copy">
                                    Reconcile the plan quickly here, then use the full workspace for recurring rules, planned transactions, and overrides.
                                </MudText>
                            </div>

                            <EditForm Model="_balanceForm" OnValidSubmit="SaveBalanceAsync">
                                <DataAnnotationsValidator />
                                <MudGrid Class="compact-balance-grid">
                                    <MudItem xs="12" md="4">
                                        <MudNumericField T="decimal?"
                                                         Label="Balance"
                                                         Variant="Variant.Outlined"
                                                         @bind-Value="_balanceForm.Amount" />
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudDatePicker Label="Balance as of"
                                                       Variant="Variant.Outlined"
                                                       @bind-Date="_balanceForm.BalanceAsOfDate" />
                                    </MudItem>
                                    <MudItem xs="12" md="4" Class="compact-balance-actions">
                                        <MudButton ButtonType="ButtonType.Submit"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Save">
                                            Save balance
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </EditForm>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@if (_showCreatePlanModal)
{
    <div class="modal-backdrop">
        <MudPaper Class="modal-card modal-card-wide pa-6">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5">Create a new budget plan</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseAllModals" />
                </MudStack>
                <MudText Typo="Typo.body2" Class="section-copy">
                    Add another plan with its own currency, balance checkpoint, and time zone.
                </MudText>

                <EditForm Model="_createForm" OnValidSubmit="CreatePlanAsync">
                    <DataAnnotationsValidator />

                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Plan name" Variant="Variant.Outlined" @bind-Value="_createForm.Name" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="Currency" Variant="Variant.Outlined" @bind-Value="_createForm.Currency" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal?" Label="Starting balance" Variant="Variant.Outlined" @bind-Value="_createForm.StartingBalance" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="Balance as of" Variant="Variant.Outlined" @bind-Date="_createForm.BalanceAsOfDate" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Time zone" Variant="Variant.Outlined" @bind-Value="_createForm.TimeZoneId" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Class="modal-actions mt-4">
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle">
                            Create plan
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    </div>
}

@if (_showDeletePlanModal)
{
    <div class="modal-backdrop">
        <MudPaper Class="modal-card pa-6">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h5">Delete budget plan</MudText>
                <MudText Typo="Typo.body2" Class="section-copy">
                    Delete '@_deletePlanName'? This removes the plan, forecast history, recurring rules, planned transactions, and overrides from local storage.
                </MudText>

                <MudStack Row="true" Class="modal-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="DeletePlanAsync">
                        Delete plan
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </div>
}
