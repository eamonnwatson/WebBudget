@page "/"
@rendermode InteractiveServer

@* Serves as the landing dashboard for plan selection, forecasting, and quick balance updates. *@
<PageTitle>@(_selectedPlan?.Name ?? "Budget dashboard")</PageTitle>

<SectionContent SectionName="AppBarActions">
    @if (_selectedPlan is not null)
    {
        <EditForm Model="_forecastForm" OnValidSubmit="RunForecastAsync" class="appbar-forecast-form">
            <DataAnnotationsValidator />

            <MudSelect T="Guid"
                       Label="Plan"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Class="appbar-plan-select"
                       Value="_selectedPlan.PlanId"
                       ValueChanged="ChangeSelectedPlanAsync">
                @foreach (var plan in _plans)
                {
                    <MudSelectItem Value="@plan.PlanId">@plan.Name</MudSelectItem>
                }
            </MudSelect>

            <div class="appbar-plan-actions">
                <MudTooltip Text="New plan">
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                   ButtonType="ButtonType.Button"
                                   Color="Color.Primary"
                                   Class="appbar-plan-action"
                                   OnClick="OpenCreatePlanModal" />
                </MudTooltip>

                <MudTooltip Text="Edit plan">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   ButtonType="ButtonType.Button"
                                   Color="Color.Primary"
                                   Class="appbar-plan-action"
                                   OnClick="OpenEditPlanModal" />
                </MudTooltip>

                <MudTooltip Text="Delete plan">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   ButtonType="ButtonType.Button"
                                   Color="Color.Error"
                                   Class="appbar-plan-action appbar-plan-action-delete"
                                   OnClick="OpenDeletePlanModal" />
                </MudTooltip>
            </div>

            <MudDatePicker Label="Start"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Class="appbar-forecast-field"
                           @bind-Date="_forecastForm.StartDate" />
            <MudDatePicker Label="End"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Class="appbar-forecast-field"
                           @bind-Date="_forecastForm.EndDate" />

            <MudTooltip Text="Refresh forecast">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               ButtonType="ButtonType.Submit"
                               Color="Color.Primary"
                               Class="appbar-refresh" />
            </MudTooltip>
        </EditForm>
    }
</SectionContent>

<div class="dashboard-page">
<MudStack Spacing="4">

    @if (_isLoading)
    {
        <MudPaper Class="surface-card state-card" Elevation="0">
            <div class="loading-state">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        </MudPaper>
    }
    else if (_selectedPlan is null)
    {
        <MudPaper Class="surface-card empty-state-card" Elevation="0">
            <MudStack Spacing="3">
                <BudgetSectionHeader Kicker="Start here"
                                     Title="Create your first budget plan"
                                     TitleTypo="Typo.h4"
                                     Description="Start with a reconciled balance, currency, and time zone, then use forecasts to understand upcoming cash pressure across the year." />

                <MudGrid Class="empty-state-grid">
                    <MudItem xs="12" md="4">
                        <MudPaper Class="empty-feature-card" Elevation="0">
                            <MudText Typo="Typo.subtitle1">Forecast cash flow</MudText>
                            <MudText Typo="Typo.body2" Class="muted-copy">
                                See how recurring rules and planned transactions shape the balance trend across the selected range.
                            </MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="empty-feature-card" Elevation="0">
                            <MudText Typo="Typo.subtitle1">Surface risk early</MudText>
                            <MudText Typo="Typo.body2" Class="muted-copy">
                                Highlight the first below-zero day and focus attention on the most urgent windows.
                            </MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="empty-feature-card" Elevation="0">
                            <MudText Typo="Typo.subtitle1">Refine details later</MudText>
                            <MudText Typo="Typo.body2" Class="muted-copy">
                                Jump into the workspace only when you need to manage rules, one-offs, or occurrence overrides.
                            </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircle"
                           OnClick="OpenCreatePlanModal">
                    Create plan
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid Class="metric-grid">
            <MudItem xs="12" sm="6" xl="3">
                <DashboardMetricCard Label="Today's balance"
                                     Icon="@Icons.Material.Filled.AccountBalanceWallet"
                                     Tone="primary"
                                     Value="@(TodayBalancePoint is null ? "Outside window" : FormatMoney(TodayBalancePoint.EndOfDayBalance))"
                                     Detail="@(TodayBalancePoint is null ? $"Include {DateTime.Today:MMM d, yyyy} in the selected range." : FormatDate(TodayBalancePoint.Date))"
                                     Badge="@(TodayBalancePoint is null ? ForecastWindowLabel : "Live checkpoint")" />
            </MudItem>

            <MudItem xs="12" sm="6" xl="3">
                <DashboardMetricCard Label="Maximum balance"
                                     Icon="@Icons.Material.Filled.NorthEast"
                                     Tone="success"
                                     Value="@FormatMoney(_forecastResult!.Summary.MaxBalance)"
                                     Detail="@FormatDate(_forecastResult.Summary.MaxDate)"
                                     Badge="Peak within window" />
            </MudItem>

            <MudItem xs="12" sm="6" xl="3">
                <DashboardMetricCard Label="Minimum balance"
                                     Icon="@Icons.Material.Filled.SouthEast"
                                     Tone="warning"
                                     Value="@FormatMoney(_forecastResult!.Summary.MinBalance)"
                                     Detail="@FormatDate(_forecastResult.Summary.MinDate)"
                                     Badge="Lowest point" />
            </MudItem>

            <MudItem xs="12" sm="6" xl="3">
                <DashboardMetricCard Label="First below zero"
                                     Icon="@Icons.Material.Filled.WarningAmber"
                                     Tone="@HealthTone"
                                     Value="@(_forecastResult!.Summary.FirstBelowZeroDate is DateOnly firstBelowZeroDate ? FormatDate(firstBelowZeroDate) : "Stays positive")"
                                     Detail="@(_forecastResult.Summary.FirstBelowZeroDate is null ? "No below-zero day appears inside this forecast window." : HealthState.Detail)"
                                     Badge="@HealthState.Badge" />
            </MudItem>
        </MudGrid>

        <MudPaper Class="surface-card chart-card" Elevation="0">
            <BudgetSectionHeader Kicker="Balance trend"
                                 Title="Forecast window"
                                 Description="Daily end-of-day balances across the selected range, anchored by the latest saved balance checkpoint.">
                <Actions>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                        @(ForecastWindowDayCount == 0 ? "Window pending" : $"{ForecastWindowDayCount} day window")
                    </MudChip>
                </Actions>
            </BudgetSectionHeader>

            <ForecastTrendChart Points="@(_forecastResult?.DailyPoints ?? [])"
                                Currency="@_selectedPlan.Currency"
                                FirstBelowZeroDate="@_forecastResult?.Summary.FirstBelowZeroDate" />
        </MudPaper>

        <MudPaper Class="surface-card transaction-card" Elevation="0">
            <BudgetSectionHeader Kicker="Recent and upcoming"
                                 Title="Cash flow around today"
                                 Description="Shows the last 10 days, today's current balance, and the upcoming transactions inside the selected forecast window.">
                <Actions>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
                        @($"{TransactionRows.Count} item(s)")
                    </MudChip>
                </Actions>
            </BudgetSectionHeader>

            @if (TransactionRows.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No recent or upcoming transactions fall inside this window yet.
                </MudAlert>
            }
            else
            {
                <MudTable Items="TransactionRows"
                          Dense="true"
                          Hover="true"
                          FixedHeader="true"
                          Height="28rem"
                          Class="transaction-table">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Source</MudTh>
                        <MudTh Style="text-align:right;">Amount</MudTh>
                        <MudTh Style="text-align:right;">End-of-day balance</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date"
                               Class="@GetCellClass(context)">
                            @FormatDate(context.Date)
                        </MudTd>
                        <MudTd DataLabel="Name"
                               Class="@GetCellClass(context, GetNameClass(context))">
                            @context.Name
                        </MudTd>
                        <MudTd DataLabel="Source"
                               Class="@GetCellClass(context, GetSourceClass(context))">
                            @context.SourceLabel
                        </MudTd>
                        <MudTd DataLabel="Amount"
                               Class="@GetCellClass(context, GetAmountClass(context))"
                               Style="text-align:right;">
                            @FormatRowAmount(context)
                        </MudTd>
                        <MudTd DataLabel="End-of-day balance"
                               Class="@GetCellClass(context, GetBalanceClass(context))"
                               Style="text-align:right;">
                            @FormatMoney(context.EndOfDayBalance)
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudGrid Class="dashboard-secondary-grid">
            <MudItem xs="12" lg="6">
                <MudPaper Class="@($"surface-card health-card health-card-{HealthTone}")" Elevation="0">
                    <BudgetSectionHeader Kicker="Balance health"
                                         Title="@HealthState.Heading"
                                         Description="@HealthState.Detail">
                        <Actions>
                            <MudChip T="string" Variant="Variant.Filled" Color="@GetHealthColor(HealthState.Tone)">
                                @HealthState.Badge
                            </MudChip>
                        </Actions>
                    </BudgetSectionHeader>

                    <MudText Typo="Typo.body2" Class="muted-copy">
                        Reconcile the latest balance from this dashboard, then jump into the workspace when you need to tune recurring rules or individual items.
                    </MudText>

                    <MudButton Href="@WorkspaceHref"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.OpenInNew">
                        Open workspace
                    </MudButton>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="6">
                <MudPaper Class="surface-card reconcile-card" Elevation="0">
                    <BudgetSectionHeader Kicker="Reconcile"
                                         Title="Update balance checkpoint"
                                         Description="@($"Current checkpoint {FormatMoney(_selectedPlan.StartingBalance)} as of {FormatDate(_selectedPlan.BalanceAsOfDate)}.")" />

                    <EditForm Model="_balanceForm" OnValidSubmit="SaveBalanceAsync">
                        <DataAnnotationsValidator />

                        <MudGrid Class="reconcile-form">
                            <MudItem xs="12" md="6">
                                <MudNumericField T="decimal?"
                                                 Label="Balance"
                                                 Variant="Variant.Outlined"
                                                 @bind-Value="_balanceForm.Amount" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudDatePicker Label="Balance as of"
                                               Variant="Variant.Outlined"
                                               @bind-Date="_balanceForm.BalanceAsOfDate" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Save">
                                    Save balance
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

<BudgetModalShell Visible="_showPlanModal"
                  Wide="true"
                  Title="@PlanModalTitle"
                  Kicker="@PlanModalKicker"
                  Description="@PlanModalDescription"
                  OnClose="CloseAllModals">
    <EditForm Model="_planForm" OnValidSubmit="SavePlanAsync">
        <DataAnnotationsValidator />

        <MudGrid Class="plan-modal-grid">
            <MudItem xs="12" md="5">
                <MudTextField T="string"
                              Label="Plan name"
                              Variant="Variant.Outlined"
                              @bind-Value="_planForm.Name" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField T="string"
                              Label="Currency"
                              Variant="Variant.Outlined"
                              Disabled="@_isEditingPlan"
                              @bind-Value="_planForm.Currency" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="decimal?"
                                 Label="Starting balance"
                                 Variant="Variant.Outlined"
                                 @bind-Value="_planForm.StartingBalance" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker Label="Balance as of"
                               Variant="Variant.Outlined"
                               @bind-Date="_planForm.BalanceAsOfDate" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string"
                              Label="Time zone"
                              Variant="Variant.Outlined"
                              @bind-Value="_planForm.TimeZoneId" />
            </MudItem>
        </MudGrid>

        @if (_isEditingPlan)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Currency remains fixed once a plan exists so all saved transactions and forecast data stay consistent.
            </MudAlert>
        }

        <MudStack Row="true" Class="modal-actions">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@(_isEditingPlan ? Icons.Material.Filled.Save : Icons.Material.Filled.AddCircle)">
                @PlanModalSubmitText
            </MudButton>
        </MudStack>
    </EditForm>
</BudgetModalShell>

<BudgetModalShell Visible="_showDeletePlanModal"
                  Title="Delete budget plan"
                  Kicker="Destructive action"
                  Description="@DeletePlanMessage"
                  OnClose="CloseAllModals">
    <MudStack Spacing="3">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This action cannot be undone.
        </MudAlert>

        <MudStack Row="true" Class="modal-actions">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseAllModals">Cancel</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeletePlanAsync">
                Delete plan
            </MudButton>
        </MudStack>
    </MudStack>
</BudgetModalShell>
</div>
